{
  "expo": {
    "name": "Safeguard",
    "slug": "safeguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "safeguard",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brajabi.safeguard",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["shadowrocket"]
      }
    },
    "android": {
      "package": "com.brajabi.safeguard",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Safeguard to compare your device location with your approximate IP location. Your coordinates are not sent to IP lookup services."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "84643c45-3910-475a-87fc-5499305ed52e"
      }
    },
    "owner": "brajabi"
  }
}
