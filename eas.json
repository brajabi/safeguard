{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "developmentClient": false,
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      }
    },
    "testflight": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6810145614"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6810145614"
      }
    }
  }
}
